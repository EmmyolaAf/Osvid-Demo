# ==============================================================================
# OSVID WEB APPLICATION - PRODUCTION & STAGING ENVIRONMENT CONTRACT
# ==============================================================================
# IMPORTANT SECURITY RULES:
# 1. Do NOT put real secrets in this file. It is a committed template only.
# 2. Never commit .env, .env.local, or .env.production to source control.
# 3. Cloud Run production uses Google Secret Manager or Cloud Run env vars.
# 4. Cloud Run uses Application Default Credentials (ADC); do NOT upload service-account JSON.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER SECRETS (Cloud Run Environment / Secret Manager - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Paystack API Secret Key (e.g. sk_live_... or sk_test_...)
PAYSTACK_SECRET_KEY=sk_test_placeholder_key_here

# Resend Transactional Email API Key (e.g. re_...)
RESEND_API_KEY=re_placeholder_key_here

# Shared secret for authenticating internal maintenance cron requests (e.g. Cloud Scheduler)
MAINTENANCE_CRON_SECRET=placeholder_random_32_char_hex_cron_secret

# ------------------------------------------------------------------------------
# 2. SERVER CONFIGURATION (Non-secret server parameters)
# ------------------------------------------------------------------------------
# Cloud Run container port (Cloud Run sets this automatically to 8080)
PORT=8080

# Node environment mode: production, development, or test
NODE_ENV=production

# GCP / Firebase Project ID
FIREBASE_PROJECT_ID=osvid-9d4d6

# Verified sender email for order confirmations and notifications
FROM_EMAIL=orders@osvid.com.ng

# Internal BCC recipient for order copies and notifications (optional)
BCC_EMAIL=osvidbusinesses@gmail.com

# Maintenance mode toggle (set "true" to enable maintenance splash)
MAINTENANCE_MODE=false

# ------------------------------------------------------------------------------
# 3. PUBLIC CONFIGURATION (Safe for browser / Client exposure via NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Canonical base URL for production / staging
NEXT_PUBLIC_BASE_URL=https://osvid.com.ng

# Google Analytics 4 Measurement ID (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS=G-155SZC6EDP

# Firebase Web App client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB_wqUDc-3pGd7Us9hC7ZA4QmipvpnaxbQ
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=osvid-9d4d6.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=osvid-9d4d6
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=osvid-9d4d6.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=953662513555
NEXT_PUBLIC_FIREBASE_APP_ID=1:953662513555:web:7dcd113b2e52b8722ec866
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-155SZC6EDP

# ------------------------------------------------------------------------------
# 4. LOCAL DEVELOPMENT ONLY (Never use in Cloud Run production)
# ------------------------------------------------------------------------------
# Optional: Local-only service account key JSON string (fallback when ADC is not configured locally)
# FIREBASE_SERVICE_ACCOUNT_KEY=
