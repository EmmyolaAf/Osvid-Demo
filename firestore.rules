rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // AUTHORIZATION HELPERS (LIVE FIRESTORE STATE ENFORCEMENT)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Authoritative Super Admin: strictly the designated primary provider account with verified identity
    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'abolarinwaemmanuelfree@gmail.com' &&
        (
          request.auth.token.email_verified == true ||
          request.auth.token.firebase.sign_in_provider == 'google.com' ||
          (request.auth.token.keys().hasAny(['isProviderOwner', 'provider_owner']) &&
           (request.auth.token.isProviderOwner == true || request.auth.token.provider_owner == true))
        );
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Live staff verification: must have an existing profile with isActive == true
    function isLiveActiveStaff() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        userDocExists() &&
        getUserData().isActive == true
      );
    }

    // Admin requires live active profile with role == 'admin' (or primary Super Admin)
    function isAdmin() {
      return isSuperAdmin() || (
        isLiveActiveStaff() &&
        getUserData().role == 'admin'
      );
    }

    // Manager requires live active profile with role == 'manager'
    function isManager() {
      return isLiveActiveStaff() &&
        getUserData().role == 'manager';
    }

    function isStaff() {
      return isAdmin() || isManager();
    }

    // Privileged operational permission: must be actively granted in the live profile
    // Includes non-destructive fallback for existing legacy manager profiles lacking canManageInventory
    function hasManagerPermission(perm) {
      return isAdmin() || (
        isManager() &&
        ('permissions' in getUserData()) &&
        (
          getUserData().permissions[perm] == true ||
          (perm == 'canManageInventory' &&
           !('canManageInventory' in getUserData().permissions) &&
           getUserData().permissions.canManageProducts == true)
        )
      );
    }

    // Evaluates whether the tenant application is active or suspended using the minimal runtime document.
    // Enforces full structural schema validity (fail-closed if missing, malformed, or suspended).
    function isSubscriptionOperational() {
      let subDoc = /databases/$(database)/documents/runtime_settings/subscription;
      return exists(subDoc) &&
        ('clientId' in get(subDoc).data) &&
        get(subDoc).data.clientId == "osvid" &&
        ('isSuspended' in get(subDoc).data) &&
        get(subDoc).data.isSuspended is bool &&
        get(subDoc).data.isSuspended == false &&
        ('hardSuspendAt' in get(subDoc).data) &&
        get(subDoc).data.hardSuspendAt is timestamp &&
        request.time < get(subDoc).data.hardSuspendAt;
    }

    // ===============================================================
    // 1. USERS & RBAC COLLECTION
    // ===============================================================
    match /users/{userId} {
      // User can read self; Live Staff can read directory for operations
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isStaff()
      );

      // Customer account creation on register: strictly role 'user', no permissions allowed
      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'user' &&
        !('permissions' in request.resource.data);

      // Updates:
      // Customers can update self via strict field-level allowlist, strictly protecting server-owned
      // and identity-managed fields (role, permissions, isActive, email, lastLoginAt, etc.).
      // Direct client updates to staff roles/permissions are forbidden; must use Admin API endpoints.
      allow update: if isAuthenticated() && (
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'firstName', 'lastName', 'fullName',
          'phoneNumber', 'photoURL', 'avatar',
          'addresses', 'shippingAddress', 'billingAddress',
          'preferences', 'updatedAt'
        ]) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'permissions', 'isActive', 'createdBy', 'createdAt',
          'totalOrders', 'totalSpent', 'lastOrderDate', 'subscription',
          'lastLoginAt', 'email'
        ])
      );

      // Direct client deletion of accounts is forbidden; must use authenticated Admin API
      allow delete: if false;
    }

    // ===============================================================
    // 2. PRODUCT CATALOG & CATEGORIES
    // ===============================================================
    match /products/{productId} {
      allow read: if true; // Public catalog

      // Product creation requires catalogue permission and operational subscription.
      // Product Manager without Inventory permission CANNOT create initial positive stock.
      allow create: if (isSuperAdmin() || isSubscriptionOperational()) &&
        hasManagerPermission('canManageProducts') &&
        (hasManagerPermission('canManageInventory') || !('stockQuantity' in request.resource.data) || request.resource.data.stockQuantity == 0);

      // Product updates: strictly isolate catalogue authority from inventory stock adjustments.
      allow update: if (isSuperAdmin() || isSubscriptionOperational()) && (
        // Case 1: Caller holds both Catalogue and Inventory permissions (or Admin / Super Admin)
        (hasManagerPermission('canManageProducts') && hasManagerPermission('canManageInventory'))
        ||
        // Case 2: Catalogue-only Manager cannot modify stockQuantity
        (hasManagerPermission('canManageProducts') &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stockQuantity']))
        ||
        // Case 3: Inventory-only Manager can ONLY modify stockQuantity and updatedAt
        (hasManagerPermission('canManageInventory') &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQuantity', 'updatedAt']))
      );

      // Catalogue deletion strictly requires catalogue authority and operational subscription
      allow delete: if (isSuperAdmin() || isSubscriptionOperational()) &&
        hasManagerPermission('canManageProducts');
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageProducts'));
    }

    match /product_categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageProducts'));
    }

    // ===============================================================
    // 3. ORDERS & COMMERCE
    // ===============================================================
    match /orders/{orderId} {
      // Customer reads their own orders; Live Staff reads all orders
      allow read: if isStaff() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.customerEmail == request.auth.token.email
        )
      );

      // Deny direct client order creation entirely.
      // All orders are securely verified and written server-side by the Firebase Admin SDK.
      allow create: if false;

      // Updates: only staff with live order management permission and operational subscription
      allow update: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageOrders'));

      allow delete: if isSuperAdmin() || (isSubscriptionOperational() && isAdmin());
    }

    // ===============================================================
    // 4. DISCOUNTS & PROMOTIONS
    // ===============================================================
    match /discounts/{discountId} {
      allow read: if true; // Public checkout code validation
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageDiscounts'));
    }

    // ===============================================================
    // 5. RUNTIME & SYSTEM SETTINGS
    // ===============================================================
    match /runtime_settings/{settingId} {
      // Minimal safe client-runtime subscription document (publicly readable)
      allow read: if true;
      // All mutations must go through authenticated Super Admin API via Firebase Admin SDK
      allow write: if false;
    }

    // Provider system settings: strictly private to Super Admin.
    // Ordinary Admins and Managers MUST NOT be able to read subscription or main_business
    // through any overlapping wildcard rule.
    match /system_settings/{settingId} {
      allow read: if isSuperAdmin() || (
        isStaff() &&
        settingId != "subscription" &&
        settingId != "main_business"
      );
      allow write: if isSuperAdmin();
    }

    // ===============================================================
    // 6. CMS & WEBSITE CONTENT
    // ===============================================================
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite'));
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite'));
    }

    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite'));
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite'));
    }

    match /teams/{id} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite'));
    }

    // ===============================================================
    // 7. INQUIRIES & ALERTS
    // ===============================================================
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, delete: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageCustomers'));
      allow update: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageCustomers'));
    }

    match /back_in_stock_requests/{requestId} {
      allow create: if true;
      allow read, delete: if isSuperAdmin() || (isSubscriptionOperational() && (hasManagerPermission('canManageProducts') || hasManagerPermission('canManageInventory')));
      allow update: if isSuperAdmin() || (isSubscriptionOperational() && (hasManagerPermission('canManageProducts') || hasManagerPermission('canManageInventory')));
    }

    // ===============================================================
    // 8. AUDIT LOGS (TAMPER-RESISTANT APPEND-ONLY)
    // ===============================================================
    match /audit_logs/{logId} {
      // Readable exclusively by verified Super Admin
      allow read: if isSuperAdmin();
      // Tamper-resistant: direct client writes are forbidden; writes occur via Firebase Admin SDK
      allow write: if false;
    }
  }
}
