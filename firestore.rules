rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // AUTHORIZATION HELPERS (LIVE FIRESTORE STATE ENFORCEMENT)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Authoritative Super Admin: strictly the designated primary provider account with verified identity
    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'abolarinwaemmanuelfree@gmail.com' &&
        (
          request.auth.token.email_verified == true ||
          request.auth.token.firebase.sign_in_provider == 'google.com' ||
          (request.auth.token.keys().hasAny(['isProviderOwner', 'provider_owner']) &&
           (request.auth.token.isProviderOwner == true || request.auth.token.provider_owner == true))
        );
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Live staff verification: must have an existing profile with isActive == true
    function isLiveActiveStaff() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        userDocExists() &&
        getUserData().isActive == true
      );
    }

    // Admin requires live active profile with role == 'admin' (or primary Super Admin)
    function isAdmin() {
      return isSuperAdmin() || (
        isLiveActiveStaff() &&
        getUserData().role == 'admin'
      );
    }

    // Manager requires live active profile with role == 'manager'
    function isManager() {
      return isLiveActiveStaff() &&
        getUserData().role == 'manager';
    }

    function isStaff() {
      return isAdmin() || isManager();
    }

    // Privileged operational permission: must be actively granted in the live profile
    // Includes non-destructive fallback for existing legacy manager profiles lacking canManageInventory
    function hasManagerPermission(perm) {
      return isAdmin() || (
        isManager() &&
        ('permissions' in getUserData()) &&
        (
          getUserData().permissions[perm] == true ||
          (perm == 'canManageInventory' &&
           !('canManageInventory' in getUserData().permissions) &&
           getUserData().permissions.canManageProducts == true)
        )
      );
    }

    // Evaluates whether the tenant application is active or suspended using the minimal runtime document.
    // Enforces full structural schema validity (fail-closed if missing, malformed, or suspended).
    function isSubscriptionOperational() {
      let subDoc = /databases/$(database)/documents/runtime_settings/subscription;
      return exists(subDoc) &&
        ('clientId' in get(subDoc).data) &&
        get(subDoc).data.clientId == "osvid" &&
        ('isSuspended' in get(subDoc).data) &&
        get(subDoc).data.isSuspended is bool &&
        get(subDoc).data.isSuspended == false &&
        ('hardSuspendAt' in get(subDoc).data) &&
        get(subDoc).data.hardSuspendAt is timestamp &&
        request.time < get(subDoc).data.hardSuspendAt;
    }

    // ===============================================================
    // 1. USERS & RBAC COLLECTION
    // ===============================================================
    match /users/{userId} {
      // User can read self; Live Staff can read directory for operations
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isStaff()
      );

      // Customer account creation on register: strictly role 'user', no permissions allowed
      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'user' &&
        !('permissions' in request.resource.data);

      // Updates:
      // Customers can update self via strict field-level allowlist, strictly protecting server-owned
      // and identity-managed fields (role, permissions, isActive, email, lastLoginAt, etc.).
      // Direct client updates to staff roles/permissions are forbidden; must use Admin API endpoints.
      allow update: if isAuthenticated() && (
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'firstName', 'lastName', 'fullName',
          'phoneNumber', 'photoURL', 'avatar',
          'addresses', 'shippingAddress', 'billingAddress',
          'preferences', 'updatedAt'
        ]) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'permissions', 'isActive', 'createdBy', 'createdAt',
          'totalOrders', 'totalSpent', 'lastOrderDate', 'subscription',
          'lastLoginAt', 'email'
        ])
      );

      // Direct client deletion of accounts is forbidden; must use authenticated Admin API
      allow delete: if false;
    }

    // ===============================================================
    // 2. PRODUCT CATALOG & CATEGORIES
    // ===============================================================
    match /products/{productId} {
      allow read: if true; // Public catalog

      // Helper validating product creation schema and core field types (Packet 3C)
      function isValidProductCreateData() {
        let data = request.resource.data;
        return data.keys().hasOnly([
          'id', 'name', 'slug', 'description', 'price', 'discountPrice',
          'stockQuantity', 'category', 'categorySlug', 'categoryName',
          'imageUrl', 'images', 'galleryImages', 'unit', 'sku',
          'isFeatured', 'isActive', 'features', 'specifications',
          'suggestedProductIds', 'crossSells', 'tags',
          'createdAt', 'updatedAt'
        ]) &&
        ('name' in data && data.name is string && data.name.size() > 0) &&
        ('price' in data && data.price is number && data.price >= 0) &&
        (!('stockQuantity' in data) || (data.stockQuantity is number && data.stockQuantity == 0)) &&
        (!('isActive' in data) || data.isActive is bool) &&
        (!('slug' in data) || data.slug is string) &&
        (!('sku' in data) || data.sku is string) &&
        (!('unit' in data) || data.unit is string) &&
        (!('category' in data) || data.category is string);
      }

      // Product creation: requires catalogue permission and strict create schema validation.
      // Super Admin may bypass subscription gating for administrative recovery,
      // but stockQuantity MUST still be 0 or omitted and only allowed catalogue fields may be written!
      allow create: if hasManagerPermission('canManageProducts') &&
        (isSuperAdmin() || isSubscriptionOperational()) &&
        isValidProductCreateData();

      // Product updates: catalogue management allowed, but stockQuantity MUST NOT be
      // directly changed by ANY browser caller (including Super Admin).
      // Uses explicit catalogue field allowlist to protect future server-owned product fields.
      allow update: if hasManagerPermission('canManageProducts') &&
        (isSuperAdmin() || isSubscriptionOperational()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'slug', 'description', 'price', 'discountPrice',
          'category', 'categorySlug', 'categoryName',
          'imageUrl', 'images', 'galleryImages',
          'unit', 'sku', 'isFeatured', 'isActive',
          'features', 'specifications', 'suggestedProductIds', 'crossSells', 'tags',
          'updatedAt'
        ]);

      // Catalogue deletion strictly requires catalogue authority and operational subscription (or Super Admin recovery)
      allow delete: if hasManagerPermission('canManageProducts') &&
        (isSuperAdmin() || isSubscriptionOperational());
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageProducts'));
    }

    match /product_categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageProducts'));
    }

    // ===============================================================
    // 3. ORDERS & COMMERCE
    // ===============================================================
    match /orders/{orderId} {
      // Order authority (Super Admin, Admin, Manager with canManageOrders) reads all orders.
      // Customer reads their own orders by authenticated UID or verified email fallback.
      allow read: if hasManagerPermission('canManageOrders') || (
        isAuthenticated() && (
          ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
          (
            'customerEmail' in resource.data &&
            request.auth.token.email != null &&
            resource.data.customerEmail == request.auth.token.email &&
            request.auth.token.email_verified == true
          )
        )
      );

      // All order creations, fulfillment updates, and deletions must go through server APIs
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ===============================================================
    // 4. DISCOUNTS & PROMOTIONS
    // ===============================================================
    match /discounts/{discountId} {
      // Direct coupon evaluation is now server-authoritative via /api/checkout/quote.
      // Customer read access is no longer needed; read access is restricted to staff with discount authority.
      allow read: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageDiscounts'));

      // Creation: staff with discount authority; usageCount and reservedUsageCount must be 0 or omitted
      allow create: if (isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageDiscounts'))) &&
        (!('reservedUsageCount' in request.resource.data) || request.resource.data.reservedUsageCount == 0) &&
        (!('usageCount' in request.resource.data) || request.resource.data.usageCount == 0);

      // Update: staff with discount authority; usageCount and reservedUsageCount are server-controlled
      allow update: if (isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageDiscounts'))) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reservedUsageCount']) ||
         request.resource.data.reservedUsageCount == resource.data.reservedUsageCount) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['usageCount']) ||
         request.resource.data.usageCount == resource.data.usageCount);

      // Deletion: staff with discount authority; cannot delete coupon while reservations are active (Packet 4D Requirement 7)
      allow delete: if (isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageDiscounts'))) &&
        (!('reservedUsageCount' in resource.data) || resource.data.reservedUsageCount == 0);
    }

    // ===============================================================
    // 5. RUNTIME & SYSTEM SETTINGS
    // ===============================================================
    match /runtime_settings/{settingId} {
      // Minimal safe client-runtime subscription document (publicly readable)
      allow read: if true;
      // All mutations must go through authenticated Super Admin API via Firebase Admin SDK
      allow write: if false;
    }

    // Provider system settings: strictly private to Super Admin.
    // Ordinary Admins and Managers MUST NOT be able to read subscription or main_business
    // through any overlapping wildcard rule.
    // Direct client writes are sealed (allow write: if false); provider terms must be mutated
    // exclusively through authenticated Super Admin API via Firebase Admin SDK.
    match /system_settings/{settingId} {
      allow read: if isSuperAdmin() || (
        isStaff() &&
        settingId != "subscription" &&
        settingId != "main_business"
      );
      allow write: if false;
    }

    // ===============================================================
    // 6. CMS & WEBSITE CONTENT
    // ===============================================================
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite'));
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite'));
    }

    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite'));
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite'));
    }

    match /teams/{id} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite'));
    }

    // ===============================================================
    // 7. INQUIRIES & ALERTS
    // ===============================================================
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, delete: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageCustomers'));
      allow update: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageCustomers'));
    }

    match /back_in_stock_requests/{requestId} {
      allow create: if true;
      allow read, delete: if isSuperAdmin() || (isSubscriptionOperational() && (hasManagerPermission('canManageProducts') || hasManagerPermission('canManageInventory')));
      allow update: if isSuperAdmin() || (isSubscriptionOperational() && (hasManagerPermission('canManageProducts') || hasManagerPermission('canManageInventory')));
    }

    // ===============================================================
    // 8. AUDIT LOGS (TAMPER-RESISTANT APPEND-ONLY)
    // ===============================================================
    match /audit_logs/{logId} {
      // Readable exclusively by verified Super Admin
      allow read: if isSuperAdmin();
      // Tamper-resistant: direct client writes are forbidden; writes occur via Firebase Admin SDK
      allow write: if false;
    }

    // ===============================================================
    // 9. INVENTORY MOVEMENTS LEDGER (IMMUTABLE APPEND-ONLY)
    // ===============================================================
    match /inventory_movements/{movementId} {
      // Read access: authorized staff holding inventory authority or Super Admin
      allow read: if isSuperAdmin() || (
        isSubscriptionOperational() &&
        isStaff() &&
        (isAdmin() || hasManagerPermission('canManageInventory'))
      );

      // Immutable append-only ledger: browser client writes strictly denied
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ===============================================================
    // 10. SERVER-ONLY COMMERCE & PAYMENT COLLECTIONS (PACKET 4)
    // ===============================================================
    match /checkout_sessions/{sessionId} {
      allow read: if false;
      allow write: if false;
    }

    match /payment_transactions/{txId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
