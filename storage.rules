rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Authoritative Super Admin: strictly the designated primary provider account
    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'abolarinwaemmanuelfree@gmail.com';
    }

    // Live Firestore user profile checks for storage authorization
    function userDocExists() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isLiveActiveStaff() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        userDocExists() &&
        getUserData().isActive == true
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isLiveActiveStaff() &&
        getUserData().role == 'admin'
      );
    }

    function isManager() {
      return isLiveActiveStaff() &&
        getUserData().role == 'manager';
    }

    function isStaff() {
      return isAdmin() || isManager();
    }

    function hasManagerPermission(perm) {
      return isAdmin() || (
        isManager() &&
        ('permissions' in getUserData()) &&
        getUserData().permissions[perm] == true
      );
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    // Public storefront images (product catalog)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if hasManagerPermission('canManageProducts')
        && isImageFile()
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if hasManagerPermission('canManageProducts')
        && isImageFile()
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if hasManagerPermission('canManageWebsite')
        && isImageFile()
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if hasManagerPermission('canManageWebsite')
        && isImageFile()
        && request.resource.size < 10 * 1024 * 1024;
    }

    // User profile avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin())
        && isImageFile()
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Default DENY for all unmatched storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
