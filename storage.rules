rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Authoritative Super Admin: strictly the designated primary provider account with verified identity
    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'abolarinwaemmanuelfree@gmail.com' &&
        (
          request.auth.token.email_verified == true ||
          request.auth.token.firebase.sign_in_provider == 'google.com' ||
          (request.auth.token.keys().hasAny(['isProviderOwner', 'provider_owner']) &&
           (request.auth.token.isProviderOwner == true || request.auth.token.provider_owner == true))
        );
    }

    // Live Firestore user profile checks for storage authorization
    function userDocExists() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isLiveActiveStaff() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        userDocExists() &&
        getUserData().isActive == true
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isLiveActiveStaff() &&
        getUserData().role == 'admin'
      );
    }

    function isManager() {
      return isLiveActiveStaff() &&
        getUserData().role == 'manager';
    }

    function isStaff() {
      return isAdmin() || isManager();
    }

    function hasManagerPermission(perm) {
      return isAdmin() || (
        isManager() &&
        ('permissions' in getUserData()) &&
        (
          getUserData().permissions[perm] == true ||
          (perm == 'canManageInventory' &&
           !('canManageInventory' in getUserData().permissions) &&
           getUserData().permissions.canManageProducts == true)
        )
      );
    }

    function isSubscriptionOperational() {
      let subDoc = /databases/(default)/documents/runtime_settings/subscription;
      return firestore.exists(subDoc) &&
        ('clientId' in firestore.get(subDoc).data) &&
        firestore.get(subDoc).data.clientId == "osvid" &&
        ('isSuspended' in firestore.get(subDoc).data) &&
        firestore.get(subDoc).data.isSuspended is bool &&
        firestore.get(subDoc).data.isSuspended == false &&
        ('hardSuspendAt' in firestore.get(subDoc).data) &&
        firestore.get(subDoc).data.hardSuspendAt is timestamp &&
        request.time < firestore.get(subDoc).data.hardSuspendAt;
    }

    function isAllowedImageFile() {
      return request.resource != null &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // Public storefront images (product catalog)
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageProducts')))
        && isAllowedImageFile()
        && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageProducts'));
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageProducts')))
        && isAllowedImageFile()
        && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageProducts'));
    }

    match /site/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite')))
        && isAllowedImageFile()
        && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite'));
    }

    match /blog/{allPaths=**} {
      allow read: if true;
      allow create, update: if (isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite')))
        && isAllowedImageFile()
        && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isSuperAdmin() || (isSubscriptionOperational() && hasManagerPermission('canManageWebsite'));
    }

    // User profile avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin())
        && isAllowedImageFile()
        && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Default DENY for all unmatched storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
