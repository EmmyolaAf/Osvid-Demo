rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null &&
         request.auth.token.email.lower() == 'abolarinwaemmanuelfree@gmail.com') ||
        request.auth.token.role == 'super_admin'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && request.auth.token.role == 'admin'
      );
    }

    function isManager() {
      return isAuthenticated() && request.auth.token.role == 'manager';
    }

    function hasManagerPermission(perm) {
      return isAdmin() || (
        isManager() && request.auth.token.permissions[perm] == true
      );
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    // Public storefront images (product catalog)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if hasManagerPermission('canManageProducts')
        && isImageFile()
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if hasManagerPermission('canManageProducts')
        && isImageFile()
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if hasManagerPermission('canManageWebsite')
        && isImageFile()
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if hasManagerPermission('canManageWebsite')
        && isImageFile()
        && request.resource.size < 10 * 1024 * 1024;
    }

    // User profile avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin())
        && isImageFile()
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Default DENY for all unmatched storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
